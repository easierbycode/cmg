{
  "nodeModulesDir": "manual",
  "tasks": {
    "check": "deno fmt --check . && deno lint . && deno check",
    "dev": "deno run -A scripts/dev.ts",
    "dev:vite": "vite",
    "dev:tunnel": "deno run -A scripts/dev-tunnel.ts",
    "build": "deno task tg16:manifest && deno task psx:manifest && deno task 2028-ai:bgm && deno task dashboard:build && vite build",
    "build:mac": "deno task build && deno compile -A --target aarch64-apple-darwin --include _fresh --include static --output dist/cmg-mac-arm64 scripts/launch-mac.ts",
    "dashboard:build": "deno run -A scripts/build-dashboard.ts",
    "2028-ai:bgm": "deno run -A scripts/2028-ai/download-custom-bgm.ts",
    "tg16:manifest": "deno run -A scripts/build-tg16-manifest.ts",
    "psx:manifest": "deno run -A scripts/build-psx-manifest.ts",
    "start": "deno serve -A _fresh/server.js",
    "update": "deno run -A -r jsr:@fresh/update ."
  },
  "lint": {
    "rules": {
      "tags": [
        "fresh",
        "recommended"
      ]
    }
  },
  "exclude": [
    "**/_fresh/*",
    "static/dashboard.bundle.js",
    "svelte-src/**"
  ],
  "imports": {
    "@/": "./",
    "fresh": "jsr:@fresh/core@^2.3.3",
    "preact": "npm:preact@^10.29.1",
    "@preact/signals": "npm:@preact/signals@^2.9.0",
    "@fresh/plugin-vite": "jsr:@fresh/plugin-vite@^1.1.2",
    "vite": "npm:vite@^7.1.3",
    "@types/babel__core": "npm:@types/babel__core@^7.20.5",
    "svelte": "npm:svelte@^5.16.0",
    "esbuild": "npm:esbuild@^0.24.0",
    "esbuild-svelte": "npm:esbuild-svelte@^0.9.0",
    "ws": "npm:ws@^8.18.0",
    "@types/ws": "npm:@types/ws@^8.5.10"
  },
  "compilerOptions": {
    "lib": [
      "dom",
      "dom.asynciterable",
      "dom.iterable",
      "deno.ns"
    ],
    "jsx": "precompile",
    "jsxImportSource": "preact",
    "jsxPrecompileSkipElements": [
      "a",
      "img",
      "source",
      "body",
      "html",
      "head",
      "title",
      "meta",
      "script",
      "link",
      "style",
      "base",
      "noscript",
      "template"
    ],
    "types": [
      "vite/client"
    ]
  },
  "deploy": {
    "org": "easierbycode",
    "app": "cmg"
  }
}
