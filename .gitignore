# dotenv environment variable files
.env
.env.development.local
.env.test.local
.env.production.local
.env.local

# Fresh build directory
_fresh/
# Compiled Svelte dashboard bundle (built by scripts/build-dashboard.ts)
static/dashboard.bundle.js
# npm + other dependencies
node_modules/
vendor/

# macOS
.DS_Store

# Compiled Mac binary
dist/

# APK/AppImage export staging + native project scratch (tools/build-level
# writes build/<slug>/{www,cordova,electron,dist} here per exported level).
/build/

# PSX ROM library — local-only. Fresh deploys keep these out so the dashboard
# falls back to BYOD (Bring Your Own Disc). Drop files here for a self-
# contained Mac binary via `deno task build:mac`.
static/PlayStation/*
!static/PlayStation/manifest.json

# Other imported ROM libraries (deno task openemu:import) — local-only, same
# policy as the PSX library above. Files committed before these rules were
# added stay tracked; commit new ones explicitly (git add -f) if a deploy
# target should bundle them. static/arcade also holds the Emularity player,
# so only its ROM zips are ignored.
static/SegaSaturn/*
!static/SegaSaturn/manifest.json
static/Nintendo/*
!static/Nintendo/manifest.json
static/TurboGrafx-16/*
!static/TurboGrafx-16/manifest.json
static/arcade/*.zip

# PSX BIOS (copyrighted). Keep out of public git by default — commit
# explicitly if your deployment target needs them.
static/bios/

# Generated during Mac/AppImage builds (deno task arcade:bundle) so the arcade
# core and local MAME config files are embedded into the self-contained binary
# without committing bulky/runtime-local artifacts.
static/arcade/emularity/engine/
static/arcade/cfg/
