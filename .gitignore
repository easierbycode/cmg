# dotenv environment variable files
.env
.env.development.local
.env.test.local
.env.production.local
.env.local

# Fresh build directory
_fresh/
# Compiled Svelte dashboard bundle (built by scripts/build-dashboard.ts)
static/dashboard.bundle.js
# Build identity stamp (written by scripts/compile-launcher.ts)
static/app-version.json
# npm + other dependencies
node_modules/
vendor/

# macOS
.DS_Store

# Compiled Mac binary
dist/

# APK/AppImage export staging + native project scratch (tools/build-level
# writes build/<slug>/{www,cordova,electron,dist} here per exported level).
/build/

# Locally-added + editor-published games (GAMES_DIR: /api/games/add-*,
# /api/games/voxel) — runtime content, never committed.
/games/

# PSX ROM library — local-only. Fresh deploys keep these out so the dashboard
# falls back to BYOD (Bring Your Own Disc). Drop files here for a self-
# contained Mac binary via `deno task build:mac`.
static/PlayStation/*
!static/PlayStation/manifest.json

# Other imported ROM libraries (deno task openemu:import) — local-only, same
# policy as the PSX library above. Files committed before these rules were
# added stay tracked; commit new ones explicitly (git add -f) if a deploy
# target should bundle them. static/arcade also holds the Emularity player,
# so only its ROM zips are ignored.
static/SegaSaturn/*
!static/SegaSaturn/manifest.json
static/Nintendo/*
!static/Nintendo/manifest.json
static/NintendoSwitch/*
!static/NintendoSwitch/manifest.json

# Self-built Voland core (static/switch/play.html prints the recipe). Upstream
# publishes no WASM build, so this is a local emscripten artifact — bulky and
# GPL-2.0 — while the player page itself stays tracked.
static/switch/core/
static/TurboGrafx-16/*
!static/TurboGrafx-16/manifest.json
static/arcade/*.zip
# NAOMI / Dreamcast images (and any BIOS zips dropped in beside them). Same
# policy: local-only, embedded into `deno task desktop:*` / `build:mac` builds
# by the manifest in this directory, never committed.
static/Naomi/*
!static/Naomi/manifest.json

# Fetched cover art (the wholesale-ignored ROM dirs above already cover theirs)
static/PlayStation2/covers/
static/arcade/covers/

# Console BIOS/firmware + key material (copyrighted): PSX/Saturn BIOS dumps
# and the Switch prod.keys Voland decrypts cartridges with. Keep out of public
# git by default — these must never reach a deploy or a release artifact.
# Commit explicitly only if your deployment target legitimately needs them.
static/bios/

# Generated during Mac/AppImage builds (deno task arcade:bundle) so the arcade
# core and local MAME config files are embedded into the self-contained binary
# without committing bulky/runtime-local artifacts.
static/arcade/emularity/engine/
static/arcade/cfg/

# Downloaded by deno task naomi:core (part of deno task build) — the Flycast
# WASM core, ~10 MB of binaries packed into an EmulatorJS core bundle. Same
# policy as the arcade core above.
static/naomi/core/

# Downloaded by deno task 2028-ai:bgm (first step of deno task build) — bulky
# runtime-local audio, same policy as the arcade core above.
static/games/2028-ai/assets/custom-bgm/

# game-recorder output (videos, covers, frame dumps)
out/

# Reverse-engineering fixtures for the Dezaemon 2 .sav importer: cart dumps of
# user-created games plus the retail disc they were made with (copyrighted).
# Local-only — the sibling 2019-es7 checkout keeps its own copy, which is where
# the importer's tests read from, and tests/e2e/dezaemon_daioh_import_test.ts
# skips outright when it is not there.
# The debug-tools subdirectory is original code (sprite/map dumpers, frame
# extraction) and IS tracked — only the fixture dumps stay local.
dev-fixtures/*
!dev-fixtures/debug-tools/
